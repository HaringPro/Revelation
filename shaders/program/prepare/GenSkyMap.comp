#define PASS_SKY_MAP

//======// Input //===============================================================================//

layout (local_size_x = 16, local_size_y = 16) in;
// colortex5 固定 256×256（size.buffer.colortex5），16×16 组 × 16 线程 = 256×256，正好匹配。
const ivec3 workGroups = ivec3(16, 16, 1);

//======// Utility //=============================================================================//

#include "/lib/Utility.glsl"

//======// Uniform //=============================================================================//

writeonly uniform image2D skyMapImg;

#include "/lib/universal/Uniform.glsl"

//======// SSBO //================================================================================//

#include "/lib/universal/SSBO.glsl"

//======// Function //============================================================================//

#include "/lib/universal/Random.glsl"

#include "/lib/atmosphere/Common.glsl"

#include "/lib/atmosphere/clouds/Render.glsl"
#include "/lib/atmosphere/AtmosphericFog.glsl"

//======// Main //================================================================================//
void main() {
	ivec2 tid = ivec2(gl_GlobalInvocationID.xy);

    // Checkerboard render
	ivec2 offset = checkerboardOffset2x2[frameCounter & 3];
	// [2026-08-09 修复] 棋盘条件必须用 all(equal(...))：`(tid & 1) == offset` 是 bvec2，
	// 直接放进 if 属于非法 GLSL（部分驱动行为未定义），会导致天空图写入异常 →
	// 球谐光（skySH）退化 → 朝上面过暗/缺少天空光染色。改为规范写法后行为确定：
	// 每帧只写当前棋盘相位的 1/4 纹素，4 帧全覆盖，由历史累积补全。
	if (all(equal(tid & 1, offset)) || worldTimeChanged) {
		vec2 uv = (vec2(tid) + 0.5) * rcp(imageSize(skyMapImg));

		vec3 worldDir = UnprojectSky(uv);
		vec3 skyRadiance = AtmosphereSkyView(atmosphereViewPos, worldDir, worldSunDir);

		vec2 noise = SampleStbnVec2(tid, frameCounter);

		#ifdef CLOUDS
			vec4 cloudData = RenderClouds(worldDir, noise);
			CompositeClouds(skyRadiance, cloudData, worldDir);
		#endif

		#ifdef VOLUMETRIC_FOG
			if (isEyeInWater == 0) {
				mat2x3 volFogData = RaymarchAtmosphericFog(vec3(0.0), worldDir * FLT_MAX, noise.x, true, VF_MAX_SAMPLES >> 1);
				skyRadiance = ApplyFog(skyRadiance, volFogData);
			}
		#endif

		// Accumulate
		vec4 history = texelFetch(skyMapTex, tid, 0);
		history.a *= float(!worldTimeChanged);

		skyRadiance = mix(history.rgb, skyRadiance, rcp(++history.a));
		imageStore(skyMapImg, tid, vec4(skyRadiance, min(history.a, 128.0)));
	}
}
