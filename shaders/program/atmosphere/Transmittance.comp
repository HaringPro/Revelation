//======// Input //===============================================================================//

layout (local_size_x = 16, local_size_y = 16) in;
const ivec3 workGroups = ivec3(16, 4, 1);

//======// Utility //=============================================================================//

#include "/lib/Utility.glsl"

//======// Uniform //=============================================================================//

writeonly uniform image2D tLutImg;

#include "/lib/universal/Uniform.glsl"

//======// Function //============================================================================//

#include "/lib/atmosphere/Common.glsl"

// Optimized ray-sphere intersection: returns the positive intersection distance along the ray.
// Prevents double computation when both ground and top spheres are needed.
float RaySphereIntersectNearestOpt(vec3 ro, vec3 rd, float sr, float maxDist) {
    float a = dot(rd, rd);               // = 1.0 if rd is normalized
    float b = 2.0 * dot(rd, ro);
    float c = dot(ro, ro) - (sr * sr);
    float delta = b * b - 4.0 * a * c;
    if (delta < 0.0 || a == 0.0) return maxDist; // return maxDist if no hit, used for top sphere

    float sol0 = (-b - sqrt(delta)) / (2.0 * a);
    float sol1 = (-b + sqrt(delta)) / (2.0 * a);
    
    // Return the smallest positive solution, or maxDist if none
    if (sol0 <= 0.0 && sol1 <= 0.0) return maxDist;
    float t = sol0 > 0.0 ? sol0 : sol1;
    return min(t, sol1 > 0.0 ? sol1 : t); // effectively returns the smaller positive
}

vec3 RaymarchSunTransmittance(vec3 rayPos, vec3 rayDir) {
    // Ground intersection check (combined with top intersection for efficiency)
    float tBottom = RaySphereIntersectNearestOpt(rayPos, rayDir, atmosphere.bottomRadius, -1.0);
    if (tBottom >= 0.0) {
        // Ray hits ground before going upwards; no transmittance
        return vec3(0.0);
    }

    float tTop = RaySphereIntersectNearestOpt(rayPos, rayDir, atmosphere.topRadius, 1e20);
    if (tTop <= 0.0) {
        // Ray does not intersect atmosphere
        return vec3(1.0);
    }

    const float rcpStepSize = 1.0 / float(ATMOSPHERE_TLUT_SAMPLES);
    float stepSize = tTop * rcpStepSize;
    vec3 rayStep = stepSize * rayDir;
    rayPos += 0.5 * rayStep; // half-step offset for numerical integration

    vec3 od = vec3(0.0);

    // Main integration loop (compiler may unroll automatically)
    for (uint i = 0u; i < ATMOSPHERE_TLUT_SAMPLES; ++i) {
        vec3 density = AtmosphereDensityAtPoint(rayPos);
        od += atmosphereExtinction * density;
        rayPos += rayStep;
    }

    return exp(-stepSize * od);
}

//======// Main //================================================================================//
void main() {
    ivec2 tid = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv = (vec2(tid) + 0.5) * rcp(imageSize(tLutImg));

    float viewHeight, viewZenithCos;
    UvToLutTransmittanceParams(viewHeight, viewZenithCos, uv);

    vec3 rayPos = vec3(0.0, viewHeight, 0.0);
    vec3 sunDir = vec3(0.0, viewZenithCos, sqrt(1.0 - viewZenithCos * viewZenithCos));

    imageStore(tLutImg, tid, vec4(RaymarchSunTransmittance(rayPos, sunDir), 1.0));
}