//======// Utility //=============================================================================//

#include "/lib/Utility.glsl"

//======// Input //===============================================================================//

layout(local_size_x = 16, local_size_y = 16) in;
const vec2 workGroupsRender = vec2(RENDER_SCALE, RENDER_SCALE);

//======// Output //==============================================================================//

writeonly restrict uniform image2D colorimg0;

//======// Uniform //==============================================================================//

#include "/lib/universal/Uniform.glsl"

//======// Shared Memory //=======================================================================//

const uint padRadius = 1u;
const uvec2 sharedSize = gl_WorkGroupSize.xy + (padRadius << 1u);

shared vec4 sharedTile[sharedSize.y][sharedSize.x];
shared vec4 sharedFullData[sharedSize.y][sharedSize.x];

//======// Function //============================================================================//

void SharedPreload() {
	ivec2 imageEnd = ivec2(scaledViewSize) - 1;
	ivec2 groupBase = ivec2(gl_WorkGroupID.xy * gl_WorkGroupSize.xy) - ivec2(padRadius);

	const uint sharedArea = sharedSize.x * sharedSize.y;
	const uint groupArea = gl_WorkGroupSize.x * gl_WorkGroupSize.y;
	const uint stageCount = (sharedArea + groupArea - 1u) / groupArea;

	for (uint stage = 0u; stage < stageCount; ++stage) {
		uint loadIndex = gl_LocalInvocationIndex + stage * groupArea;
		if (loadIndex < sharedArea) {
			uvec2 localTexel = uvec2(loadIndex % sharedSize.x, loadIndex / sharedSize.x);
			ivec2 sourceTexel = clamp(groupBase + ivec2(localTexel), ivec2(0), imageEnd);
			vec4 sourceData = texelFetch(colortex3, sourceTexel, 0);
			sharedTile[localTexel.y][localTexel.x] = texelFetch(colortex15, sourceTexel, 0);
			sharedFullData[localTexel.y][localTexel.x] = sourceData;
		}
	}

	memoryBarrierShared();
	barrier();
}

vec4 DofPostfilterLoad(uvec2 localTexel) {
	return sharedTile[localTexel.y][localTexel.x];
}

vec4 DofPostfilterLoadFullData(uvec2 localTexel) {
	return sharedFullData[localTexel.y][localTexel.x];
}

void DofSort3(vec3 a, vec3 b, vec3 c, out vec3 low, out vec3 median, out vec3 high) {
	vec3 minBC = min(b, c);
	vec3 maxBC = max(b, c);
	low = min(a, minBC);
	median = min(max(a, minBC), maxBC);
	high = max(a, maxBC);
}

vec3 DofMedian3x3(uvec2 localCenter, float centerCoc) {
	bool centerForeground = centerCoc < 0.0;
	vec3 samples[9];
	samples[4] = DofPostfilterLoad(localCenter).rgb;

	for (uint i = 0u; i < 8u; ++i) {
		uvec2 sampleTexel = uvec2(ivec2(localCenter) + offset3x3N[i]);
		vec4 sampleData = DofPostfilterLoad(sampleTexel);
		float sampleCoc = DofPostfilterLoadFullData(sampleTexel).a;
		float sameLayer = float((sampleCoc < 0.0) == centerForeground);
		samples[i < 4u ? i : i + 1u] = mix(samples[4], sampleData.rgb, sameLayer);
	}

	vec3 low[3], median[3], high[3];
	for (uint row = 0u; row < 3u; ++row) {
		uint base = row * 3u;
		DofSort3(samples[base], samples[base + 1u], samples[base + 2u], low[row], median[row], high[row]);
	}

	vec3 lowMax = max(max(low[0], low[1]), low[2]);
	vec3 medianMid = min(max(median[0], min(median[1], median[2])), max(median[1], median[2]));
	vec3 highMin = min(min(high[0], high[1]), high[2]);
	vec3 resultLow, resultMedian, resultHigh;
	DofSort3(lowMax, medianMid, highMin, resultLow, resultMedian, resultHigh);
	return resultMedian;
}

vec3 DofFixedBlur3x3(uvec2 localCenter, vec3 centerColor) {
	const float cornerWeight = 0.5453;
	const float sideWeight = 0.9717;
	vec3 color = centerColor;
	float weight = 1.0;

	for (uint i = 0u; i < 8u; ++i) {
		ivec2 offset = offset3x3N[i];
		uvec2 sampleTexel = uvec2(ivec2(localCenter) + offset);
		vec3 sampleColor = DofPostfilterLoadFullData(sampleTexel).rgb;
		float kernelWeight = (offset.x == 0 || offset.y == 0) ? sideWeight : cornerWeight;
		color += sampleColor * kernelWeight;
		weight += kernelWeight;
	}

	return color * rcp(weight);
}

//======// Main //================================================================================//
void main() {
	SharedPreload();

	ivec2 texelPos = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(texelPos, ivec2(scaledViewSize)))) return;

	uvec2 localCenter = gl_LocalInvocationID.xy + padRadius;
	vec4 filteredData = DofPostfilterLoad(localCenter);
	vec4 fullData = DofPostfilterLoadFullData(localCenter);
	float centerCoc = fullData.a;
	float cocRadius = abs(centerCoc);

	if (cocRadius < 0.25) {
		imageStore(colorimg0, texelPos, vec4(fullData.rgb, filteredData.a));
		return;
	}

	if (cocRadius <= 2.0) {
		vec3 fixedColor = DofFixedBlur3x3(localCenter, fullData.rgb);
		float fixedBlend = saturate(2.0 * cocRadius - 0.5);
		imageStore(colorimg0, texelPos, vec4(mix(fullData.rgb, fixedColor, fixedBlend), filteredData.a));
		return;
	}

	imageStore(colorimg0, texelPos, vec4(DofMedian3x3(localCenter, centerCoc), filteredData.a));
}
