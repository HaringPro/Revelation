//======// Input //===============================================================================//

layout(local_size_x = 16, local_size_y = 16) in;

#if DOWNSAMPLE_LEVEL == 0
const vec2 workGroupsRender = vec2(0.5, 0.5);
#elif DOWNSAMPLE_LEVEL == 1
const vec2 workGroupsRender = vec2(0.25, 0.25);
#elif DOWNSAMPLE_LEVEL == 2
const vec2 workGroupsRender = vec2(0.125, 0.125);
#elif DOWNSAMPLE_LEVEL == 3
const vec2 workGroupsRender = vec2(0.0625, 0.0625);
#elif DOWNSAMPLE_LEVEL == 4
const vec2 workGroupsRender = vec2(0.03125, 0.03125);
#elif DOWNSAMPLE_LEVEL == 5
const vec2 workGroupsRender = vec2(0.015625, 0.015625);
#endif

//======// Utility //=============================================================================//

#include "/lib/Utility.glsl"

//======// Uniform //=============================================================================//

writeonly uniform image2D colorimg4;

uniform sampler2D colortex1; // TAA image output
uniform sampler2D colortex4; // Bloom tile input

uniform vec2 originViewSize;
uniform vec2 originTexelSize;

//======// Function //============================================================================//

#if DOWNSAMPLE_LEVEL == 0
	#define bloomTileTex colortex1
#else
	#define bloomTileTex colortex4
#endif

const vec2 bloomTileOffset[6] = vec2[6](
	vec2(0.0000, 0.0000),
	vec2(0.0000, 0.5000),
	vec2(0.2500, 0.5000),
	vec2(0.2500, 0.6250),
	vec2(0.3125, 0.6250),
	vec2(0.3150, 0.6563)
);

const ivec2 sampleOffsets[13] = ivec2[13](
	ivec2(-2, -2),
	ivec2( 0, -2),
	ivec2( 2, -2),
	ivec2(-2,  0),
	ivec2( 0,  0),
	ivec2( 2,  0),
	ivec2(-2,  2),
	ivec2( 0,  2),
	ivec2( 2,  2),
	ivec2(-1, -1),
	ivec2( 1, -1),
	ivec2(-1,  1),
	ivec2( 1,  1)
);

vec3 CalculateBloomTile(vec2 uv) {
	// Custom hand-crafted 36-texel downsample (13 bilinear fetches)
	vec3 b00 = textureOffset(bloomTileTex, uv, sampleOffsets[0]).rgb;
	vec3 b01 = textureOffset(bloomTileTex, uv, sampleOffsets[1]).rgb;
	vec3 b02 = textureOffset(bloomTileTex, uv, sampleOffsets[2]).rgb;
	vec3 b10 = textureOffset(bloomTileTex, uv, sampleOffsets[3]).rgb;
	vec3 b11 = textureOffset(bloomTileTex, uv, sampleOffsets[4]).rgb;
	vec3 b12 = textureOffset(bloomTileTex, uv, sampleOffsets[5]).rgb;
	vec3 b20 = textureOffset(bloomTileTex, uv, sampleOffsets[6]).rgb;
	vec3 b21 = textureOffset(bloomTileTex, uv, sampleOffsets[7]).rgb;
	vec3 b22 = textureOffset(bloomTileTex, uv, sampleOffsets[8]).rgb;
	vec3 c00 = textureOffset(bloomTileTex, uv, sampleOffsets[9]).rgb;
	vec3 c01 = textureOffset(bloomTileTex, uv, sampleOffsets[10]).rgb;
	vec3 c10 = textureOffset(bloomTileTex, uv, sampleOffsets[11]).rgb;
	vec3 c11 = textureOffset(bloomTileTex, uv, sampleOffsets[12]).rgb;

	vec3 B00 = (b00 + b01 + b10 + b11) * 0.25;
	vec3 B01 = (b01 + b02 + b11 + b12) * 0.25;
	vec3 B10 = (b10 + b11 + b20 + b21) * 0.25;
	vec3 B11 = (b11 + b12 + b21 + b22) * 0.25;
	vec3 C00 = (c00 + c01 + c10 + c11) * 0.25;

	#if defined BLOOM_KARIS_AVERAGE && DOWNSAMPLE_LEVEL == 0
		// [Karis2013] proposes reducing the dynamic range before averaging
		vec4 bloomTile = vec4(0.0);

		float weight = karisAverage(C00) * 0.5;
		bloomTile += vec4(C00 * weight, weight);

		weight = karisAverage(B00) * 0.125;
		bloomTile += vec4(B00 * weight, weight);

		weight = karisAverage(B01) * 0.125;
		bloomTile += vec4(B01 * weight, weight);

		weight = karisAverage(B10) * 0.125;
		bloomTile += vec4(B10 * weight, weight);

		weight = karisAverage(B11) * 0.125;
		bloomTile += vec4(B11 * weight, weight);

		return bloomTile.rgb * rcp(bloomTile.a);
	#else
		return (B00 + B01 + B10 + B11) * 0.125 + C00 * 0.5;
	#endif
}

//======// Main //================================================================================//
void main() {
	vec2 srcUv = vec2(gl_GlobalInvocationID.xy) * 2.0 + 1.0;
	srcUv *= originTexelSize;

	if (any(greaterThanEqual(srcUv, vec2(exp2(-float(DOWNSAMPLE_LEVEL)))))) {
		return;
	}

	#if DOWNSAMPLE_LEVEL > 0
		const int srcIndex = DOWNSAMPLE_LEVEL - 1;
		srcUv += float(srcIndex * 8) * originTexelSize + bloomTileOffset[srcIndex];
	#endif

	vec3 bloomTile = CalculateBloomTile(srcUv);

	vec2 dstTexel = vec2(gl_GlobalInvocationID.xy + DOWNSAMPLE_LEVEL * 8);
	dstTexel += bloomTileOffset[DOWNSAMPLE_LEVEL] * originViewSize + 0.5;
	imageStore(colorimg4, scaleTexelPos(ivec2(dstTexel)), vec4(bloomTile, 1.0));
}
