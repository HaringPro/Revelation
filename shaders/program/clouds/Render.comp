//======// Utility //=============================================================================//

#include "/lib/Utility.glsl"

//======// Input //===============================================================================//

layout (local_size_x = 16, local_size_y = 16) in;

#ifndef CLOUD_TAAU_ENABLED
	const vec2 workGroupsRender = vec2(1.0, 1.0);
#elif CLOUD_TAAU_SCALE == 2
	const vec2 workGroupsRender = vec2(0.5, 0.5);
#elif CLOUD_TAAU_SCALE == 3
	const vec2 workGroupsRender = vec2(0.333333, 0.333333);
#elif CLOUD_TAAU_SCALE == 4
	const vec2 workGroupsRender = vec2(0.25, 0.25);
#endif

//======// Uniform //=============================================================================//

writeonly uniform image2D cloudOriginImg;

#include "/lib/universal/Uniform.glsl"

//======// SSBO //================================================================================//

#include "/lib/universal/SSBO.glsl"

//======// Function //============================================================================//

#include "/lib/universal/Random.glsl"
#include "/lib/universal/Transform.glsl"

#include "/lib/atmosphere/Common.glsl"

#include "/lib/atmosphere/clouds/Render.glsl"

float SampleDepthMax4x4(sampler2D depthTex, vec2 coord) {
	// 4x4 pixel neighborhood using textureGatherOffset
	float LL = maxOf(textureGatherOffset(depthTex, coord, ivec2(-2, -2)));
	float LR = maxOf(textureGatherOffset(depthTex, coord, ivec2(-2,  2)));
	float UL = maxOf(textureGatherOffset(depthTex, coord, ivec2( 2, -2)));
	float UR = maxOf(textureGatherOffset(depthTex, coord, ivec2( 2,  2)));

	return max(max(LL, LR), max(UL, UR));
}

bool SkyCheck4x4(vec2 coord) {
	// 4x4 pixel neighborhood using textureGatherOffset
	uvec4 LL = textureGatherOffset(colortex7, coord, ivec2(-2, -2), 1);
	uvec4 LR = textureGatherOffset(colortex7, coord, ivec2(-2,  2), 1);
	uvec4 UL = textureGatherOffset(colortex7, coord, ivec2( 2, -2), 1);
	uvec4 UR = textureGatherOffset(colortex7, coord, ivec2( 2,  2), 1);

	// Material ID 0 is sky
	return any(equal(LL & LR & UL & UR, uvec4(0u)));
}

//======// Main //================================================================================//
void main() {
    uvec2 localPos = RemapThread16x16(gl_LocalInvocationIndex);
    ivec2 texelPos = ivec2(localPos + gl_WorkGroupID.xy * gl_WorkGroupSize.xy);

	vec2 coord = texelToUv(texelPos);

	#ifdef CLOUD_TAAU_ENABLED
		vec2 renderCoord = (coord + taaJitter * 0.5) * CLOUD_TAAU_SCALE;
	#else
		#define renderCoord coord
	#endif

	// x: sunlight, y: skylight, z: depth, w: transmittance
	vec4 cloudOut = vec4(0.0, 0.0, 0.0, 1.0);

	if (SkyCheck4x4(renderCoord)) {
		vec2 noise = SampleStbnVec2(texelPos, frameCounter + 11);

		vec3 viewDir  = ScreenToViewDirRaw(renderCoord);
		vec3 worldDir = mat3(gbufferModelViewInverse) * viewDir;

		cloudOut = RenderClouds(worldDir, noise);
	}

	imageStore(cloudOriginImg, texelPos, cloudOut);
}
