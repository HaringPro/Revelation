{
    "includeSettings": "
    #include "/settings.glsl"
    ",
    "version": 1,
    "excludeLodsFromVanillaDepth": true,
    "opaqueDrawBuffers": [6, 7, 8],
    "translucentDrawBuffers": [16, 17, 12],
    "blending": {
        "-1": "off"
    },
    "useViewportDims": true,
    "uniforms": [
        "vxProj",
        "vxProjInv",
        "gbufferModelViewInverse",
        "cameraPosition",
        "far",
        "frameCounter",
        "frameTimeCounter",
        "taaJitter",
        "scaledTexelSize"
    ],
    "samplers": [
        "vxDepthTexOpaque",
        "noisetex",
        "depthtex0"
    ],
    #if defined(SR_ENABLE) && SR_ENABLE == 1
    "renderScale": [SR_RENDER_SCALE_FACTOR],
    #else
    #if MC_RENDER_SCALE_FACTOR_1000X == 500
    "renderScale": [0.5],
    #elif MC_RENDER_SCALE_FACTOR_1000X == 588
    "renderScale": [0.588],
    #elif MC_RENDER_SCALE_FACTOR_1000X == 600
    "renderScale": [0.6],
    #elif MC_RENDER_SCALE_FACTOR_1000X == 667
    "renderScale": [0.667],
    #elif MC_RENDER_SCALE_FACTOR_1000X == 750
    "renderScale": [0.75],
    #elif MC_RENDER_SCALE_FACTOR_1000X == 850
    "renderScale": [0.85],
    #elif MC_RENDER_SCALE_FACTOR_1000X == 900
    "renderScale": [0.9],
    #elif MC_RENDER_SCALE_FACTOR_1000X == 1000
    "renderScale": [1.0],
    #endif
    #endif

    "taaOffset": "{ return taaJitter; }"
}
